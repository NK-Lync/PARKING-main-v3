# ============================================================
# XeParking - Cấu hình biến môi trường (mẫu)
# Sao chép file này thành ".env" rồi điền giá trị thật.
# ============================================================

# ------------------------------------------------------------
# Supabase (PostgreSQL truy cập qua REST API)
# Lấy tại: Supabase Dashboard → Project → Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_your-publishable-key

# ------------------------------------------------------------
# GenAI — dự kiến dùng Gemini (Google AI Studio).
# Endpoint OpenAI-compatible chat/completions; key lấy tại:
#   https://aistudio.google.com/apikey
# Để trống AI_API_KEY để chạy chế độ phân tích nội bộ (không cần key).
# ------------------------------------------------------------
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=
AI_MODEL_NAME=gemini-2.0-flash
